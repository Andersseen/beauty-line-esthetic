{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Workers with static assets (free plan). Build first with
  // `pnpm build:cloudflare`: every page is prerendered into dist/analog/public and served as a
  // static asset; the Worker (Nitro's cloudflare-module output) only answers what no file
  // matches, such as the 404 page.
  "name": "beauty-line-esthetic",
  "main": "dist/analog/server/index.mjs",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/analog/public",
    "binding": "ASSETS",
  },
  "observability": { "enabled": true },
  // Production is served on www.beauty-line-esthetic.es (custom domains, set in the dashboard;
  // the root domain redirects to www via a Redirect Rule). No public *.workers.dev copy, but
  // per-PR preview URLs (pr-<n>-beauty-line-esthetic.andriipap01.workers.dev) stay on.
  "workers_dev": false,
  "preview_urls": true,
}
